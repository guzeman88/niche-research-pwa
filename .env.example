# ─── Niche Research PWA — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.

# ─── LLM ────────────────────────────────────────────────────────────────────
# Ollama runs locally — no key needed. Just have 'ollama serve' running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gemini — free tier (1500 req/day). Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Design generation safety
# External image providers are billing-locked by default even when a key exists.
# For free-tier testing, only add providers after confirming the account has no billing attached.
# Example: DESIGN_FREE_TIER_PROVIDERS=gemini
DESIGN_FREE_TIER_PROVIDERS=
# Set this to 1 only when you intentionally allow paid image generation.
DESIGN_ALLOW_PAID_PROVIDERS=0

# Optional image provider keys. Keep these server-side only; never expose them as VITE_ values.
IDEOGRAM_API_KEY=
RECRAFT_API_TOKEN=
KREA_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
BFL_API_KEY=
LUMA_API_KEY=
MAGNIFIC_API_KEY=
LEONARDO_API_KEY=

# Claude — optional, highest quality. Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Reddit (optional — approved community signal collection) ────────────────
# Reddit requires separate approval for commercial Data API use. Keep this 0
# until Reddit has expressly approved EtGen's collection use case.
REDDIT_DATA_API_APPROVED=0
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=EtGen/1.0 by u/your_username

# eRank has no generally documented public API. Prefer the evidence import UI.
# Only configure these after eRank grants a private endpoint for this account.
ERANK_API_URL=
ERANK_API_KEY=your_erank_api_key

# Official Etsy Open API (recommended for real listing evidence)
# Create/manage an app at https://www.etsy.com/developers/your-apps
# Either provide the full header value:
ETSY_X_API_KEY=your_keystring:your_shared_secret
# Or provide separate parts:
ETSY_API_KEYSTRING=your_keystring
ETSY_SHARED_SECRET=your_shared_secret
# Optional: only needed for Etsy endpoints/scopes that require OAuth.
ETSY_OAUTH_TOKEN=
# Optional: only set this if you operate a verified Etsy-compatible suggestion endpoint.
# Etsy does not publish a supported autocomplete endpoint.
ETSY_AUTOCOMPLETE_URL=
# HTML scraping is blocked-prone and disabled by default. Opt in only for local experiments.
ETSY_HTML_SCRAPER_ENABLED=0

# Durable evidence sync for hosted backends. The service-role key is backend-only;
# never expose it through a VITE_ variable or commit a real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_key

# Marmalead has no generally documented public API. Prefer the import UI.
# Only configure these after Marmalead grants a private endpoint.
MARMALEAD_API_URL=
MARMALEAD_API_KEY=your_marmalead_api_key

# ─── Pinterest Trends (requires an approved Pinterest business app) ─────────
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_REFRESH_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_TRENDS_REGION=US
PINTEREST_TREND_TYPE=growing
PINTEREST_TRENDS_LIMIT=50
PINTEREST_TRENDS_CACHE_SECONDS=21600

# ─── Google Daily Search Trends (public RSS; no credential) ──────────────────
GOOGLE_DAILY_TRENDS_GEO=US
GOOGLE_DAILY_TRENDS_CACHE_SECONDS=3600

# Private operator API; never use a VITE_ prefix for this token.
PIPELINE_API_TOKEN=
# Narrow trust policy for the secretless GitHub Actions collector heartbeat.
GITHUB_HEARTBEAT_AUDIENCE=etgen-evidence-collector
GITHUB_HEARTBEAT_REPOSITORY=guzeman88/niche-research-pwa
GITHUB_HEARTBEAT_WORKFLOW_REF=guzeman88/niche-research-pwa/.github/workflows/keepalive.yml@refs/heads/main
AUTO_START_SCHEDULER=0
SCHEDULER_MODE=continuous
SCHEDULER_BATCH_SIZE=5
SCHEDULER_RESEARCH_ADAPTERS=etsy_open_api,google_suggest,google_trends,pinterest_trends,reddit_etsy
PIPELINE_ALLOWED_ORIGINS=https://etgen.netlify.app
